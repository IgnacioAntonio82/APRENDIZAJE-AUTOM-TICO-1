        "    print(\"=\"*60)\n",
        "    print(f\"Entrenando modelo SVM con C = {c}\")\n",
        "    print(\"=\"*60)\n",
        "\n",
        "    # ======================================================\n",
        "    # Crear y entrenar modelo\n",
        "    # ======================================================\n",
        "\n",
        "    modelo_svm = SVC(\n",
        "        C=c,\n",
        "        random_state=42\n",
        "    )\n",
        "\n",
        "    modelo_svm.fit(X_train, y_train)\n",
        "\n",
        "    # ======================================================\n",
        "    # Predicciones\n",
        "    # ======================================================\n",
        "\n",
        "    y_train_pred = modelo_svm.predict(X_train)\n",
        "    y_test_pred = modelo_svm.predict(X_test)\n",
        "\n",
        "    # ======================================================\n",
        "    # Guardar métricas\n",
        "    # ======================================================\n",
        "\n",
        "    resultados.append({\n",
        "\n",
