        "    print(\"=\" * 60)\n",
        "\n",
        "    # Crear modelo\n",
        "    modelo = KMeans(\n",
        "        n_clusters=k,\n",
        "        random_state=42,\n",
        "        n_init=10\n",
        "    )\n",
        "\n",
        "    # Entrenar modelo\n",
        "    etiquetas = modelo.fit_predict(X_train)\n",
        "\n",
        "    # Guardar resultados\n",
        "    resultados.append({\n",
        "        \"k\": k,\n",
        "        \"Inercia\": modelo.inertia_,\n",
        "        \"Silhouette Score\": silhouette_score(X_train, etiquetas)\n",
