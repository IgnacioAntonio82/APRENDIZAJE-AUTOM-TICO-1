        "\n",
        "print(\"\\nSe eliminaron los registros con valores faltantes en la variable objetivo (outcome).\")\n",
        "print(\"La variable objetivo representa la clase que debe predecir el modelo, por lo que no es adecuado imputar sus valores.\")\n",
        "\n",
        "# ======================================\n",
        "# Conversión del target\n",
